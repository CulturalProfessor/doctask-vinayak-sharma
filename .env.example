# Copy to .env and fill in. Never commit .env.

# Postgres (docker compose brings this up on host port 5434)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/doctask
DB_PORT=5434

# Host port for the API. Change both if these clash on your machine.
API_PORT=8010

# SuperDocs — only needed for the Task 2 build, not for this repo's tests.
SUPERDOCS_API_KEY=your-key-here
SUPERDOCS_BASE_URL=https://api.superdocs.app

# The watched location. Files dropped into WATCH_DIR become arrivals: the same
# operation POST /arrivals and doctask_document_arrived call, halted at the same
# gate. Off by default so nothing starts a background loop unasked;
# docker compose turns it on.
#
# WATCH_DIR must be inside corpora/ -- arrivals resolve under that root, and the
# watcher goes through the same path check as every other caller.
WATCH_ENABLED=false
WATCH_DIR=./corpora/inbox
WATCH_PILE=acme
WATCH_INTERVAL_SECONDS=3

# Cost guardrails. Runs stop rather than silently spending.
MAX_MODEL_CALLS_PER_RUN=200
SAMPLE_MODE=false

# Model provider for the agentic system.
#   fake       replay recorded fixtures -- no key, no network (the default)
#   openrouter live calls; the default model is priced at zero
#   anthropic  live calls, paid
LLM_PROVIDER=fake
OPEN_ROUTER_KEY=your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
